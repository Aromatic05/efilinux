#!/bin/sh

set -eu

usage() {
    cat >&2 <<'USAGE'
usage: zxmod-build --id ID --version VERSION [--arch ARCH] [--description TEXT] ROOT OUTPUT.zxm

ROOT may contain only usr/ and opt/. Metadata is written as metadata/manifest.
USAGE
    exit 2
}

id=
version=
arch=$(uname -m)
description=
newline='
'

while [ $# -gt 0 ]; do
    case $1 in
        --id) [ $# -ge 2 ] || usage; id=$2; shift 2 ;;
        --version) [ $# -ge 2 ] || usage; version=$2; shift 2 ;;
        --arch) [ $# -ge 2 ] || usage; arch=$2; shift 2 ;;
        --description) [ $# -ge 2 ] || usage; description=$2; shift 2 ;;
        --) shift; break ;;
        -*) usage ;;
        *) break ;;
    esac
done

[ $# -eq 2 ] && [ -n "$id" ] && [ -n "$version" ] || usage
case $id in ''|[!a-z0-9]*|*[!a-z0-9._-]*) usage ;; esac
[ ${#id} -le 64 ] || usage
case $version in ''|*[!A-Za-z0-9._+:-]*) usage ;; esac
case $arch in ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) usage ;; esac
case $description in *"$newline"*) usage ;; esac

root=$1
output=$2
[ -d "$root" ] && [ ! -L "$root" ] || {
    printf 'zxmod-build: ROOT is not a directory\n' >&2
    exit 1
}
[ ! -e "$output" ] || {
    printf 'zxmod-build: refusing to replace %s\n' "$output" >&2
    exit 1
}
case $output in
    *.zxm) ;;
    *) printf 'zxmod-build: output must end in .zxm\n' >&2; exit 1 ;;
esac

for entry in "$root"/*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    case $(basename -- "$entry") in
        usr|opt) [ -d "$entry" ] && [ ! -L "$entry" ] || exit 1 ;;
        *) printf 'zxmod-build: ROOT may only contain usr and opt\n' >&2; exit 1 ;;
    esac
done
if find "$root" -mindepth 1 ! -type d ! -type f ! -type l -print -quit | grep -q .; then
    printf 'zxmod-build: special files are not supported\n' >&2
    exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' 0 1 2 15
mkdir -p "$work/metadata" "$work/root"
cp -a "$root/." "$work/root/"
{
    printf 'format=1\n'
    printf 'id=%s\n' "$id"
    printf 'arch=%s\n' "$arch"
    printf 'version=%s\n' "$version"
    [ -n "$description" ] && printf 'description=%s\n' "$description"
} > "$work/metadata/manifest"
mksquashfs "$work" "$output" -noappend -comp zstd -Xcompression-level 19 \
    -all-root -no-xattrs -no-exports -mkfs-time 0 -all-time 0 >/dev/null
