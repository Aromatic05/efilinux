# Default GTK 2 settings for the EFILinux desktop user.
gtk-theme-name="Matcha-dark-sea"
gtk-icon-theme-name="CatOS-Papirus-Dark-Maia"
gtk-font-name="Noto Sans CJK SC 10"
gtk-cursor-theme-name="breeze-cursors"
gtk-cursor-theme-size=24
gtk-enable-event-sounds=0
gtk-enable-input-feedback-sounds=0
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle="hintslight"
gtk-xft-rgba="rgb"
