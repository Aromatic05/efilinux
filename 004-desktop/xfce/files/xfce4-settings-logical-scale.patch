@@ -414,0 +415,18 @@
+static gdouble
+display_setting_scale_to_transform (gdouble scale)
+{
+    if (scale <= 0.0)
+        return scale;
+
+    return 1.0 / scale;
+}
+
+static gdouble
+display_setting_transform_to_scale (gdouble transform)
+{
+    if (transform <= 0.0)
+        return transform;
+
+    return 1.0 / transform;
+}
+
@@ -421 +439 @@
