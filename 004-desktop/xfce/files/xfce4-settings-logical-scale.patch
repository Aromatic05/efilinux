+    scale = display_setting_scale_to_transform (gtk_spin_button_get_value (spinbutton));
@@ -472,0 +491 @@
+    gdouble   configured_scale;
@@ -476,0 +496 @@
+    configured_scale = display_setting_transform_to_scale (xfce_randr->scalex[active_output]);
@@ -478 +498 @@
