_zxmod() {
    local current=${COMP_WORDS[COMP_CWORD]}
    local command=${COMP_WORDS[1]-}
    local candidate candidates id source identity

    if (( COMP_CWORD == 1 )); then
        COMPREPLY=($(compgen -W 'load unload' -- "$current"))
        return
    fi

    case $command in
        load)
            COMPREPLY=()
            candidates=$(compgen -f -- "$current") || true
            local IFS=$'\n'
            for candidate in $candidates; do
                if [[ -d $candidate || $candidate == *.zxm ]]; then
                    COMPREPLY+=("$candidate")
                fi
            done
            compopt -o filenames 2>/dev/null || true
            ;;
        unload)
            COMPREPLY=()
            local active_file=${ZXMOD_RUN_ROOT:-/run/zxmod}/active
            if [[ -r $active_file ]]; then
                while IFS=$'\t' read -r id source; do
                    [[ $id == "$current"* ]] && COMPREPLY+=("$id")
                done < "$active_file"
            fi
            ;;
    esac
    return 0
}
complete -F _zxmod zxmod
