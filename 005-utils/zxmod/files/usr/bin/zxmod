#!/bin/sh

set -eu

. "${ZXMOD_LIBRARY:-/usr/lib/zxmod/common.sh}"

ZXMOD_TEMP_FILES=
ZXMOD_PENDING_MOUNT=
ZXMOD_PENDING_LOOP=
ZXMOD_PENDING_LOOP_RECORD=

usage() {
    cat >&2 <<'USAGE'
usage: zxmod load FILE.zxm
       zxmod unload ID
USAGE
    exit 2
}

zxmod_track_temp() {
    ZXMOD_TEMP_FILES="$ZXMOD_TEMP_FILES $1"
}

cleanup() {
    zxmod_status=$?
    trap - 0 1 2 15
    if [ "$zxmod_status" -ne 0 ]; then
        if [ -n "$ZXMOD_PENDING_MOUNT" ]; then
            umount -l "$ZXMOD_PENDING_MOUNT" 2>/dev/null || :
            rmdir "$ZXMOD_PENDING_MOUNT" 2>/dev/null || :
        fi
        if [ -n "$ZXMOD_PENDING_LOOP" ]; then
            /usr/bin/losetup --detach "$ZXMOD_PENDING_LOOP" 2>/dev/null || :
        fi
        [ -z "$ZXMOD_PENDING_LOOP_RECORD" ] || rm -f -- "$ZXMOD_PENDING_LOOP_RECORD"
    fi
    for zxmod_temp in $ZXMOD_TEMP_FILES; do
        rm -f -- "$zxmod_temp"
    done
    zxmod_release_lock
    exit "$zxmod_status"
}
trap cleanup 0 1 2 15

load() {
    [ $# -eq 1 ] || usage
    zxmod_require_root
    zxmod_source=$(zxmod_require_module_file "$1")
    zxmod_identity=$(zxmod_source_identity "$zxmod_source")
    zxmod_prepare_runtime
    zxmod_manifest="$ZXMOD_RUN_ROOT/manifest.$$"
    zxmod_track_temp "$zxmod_manifest"
    zxmod_read_manifest "$zxmod_source" "$zxmod_manifest"
    zxmod_active_has_id "$ZXMOD_RUN_ROOT/active" "$zxmod_id" &&
        zxmod_die "module is already active: $zxmod_id"

    zxmod_mount="$ZXMOD_RUN_ROOT/modules/$zxmod_id"
    zxmod_loop_record="$ZXMOD_RUN_ROOT/loops/$zxmod_id"
    [ ! -e "$zxmod_mount" ] || zxmod_die "module runtime path already exists: $zxmod_id"
    [ ! -e "$zxmod_loop_record" ] || zxmod_die "module loop record already exists: $zxmod_id"
    mkdir -p "$zxmod_mount"
    ZXMOD_PENDING_MOUNT=$zxmod_mount
    zxmod_loop=$(/usr/bin/losetup --find --show --read-only "$zxmod_source") ||
        zxmod_die "cannot allocate a loop device for module: $zxmod_source"
    ZXMOD_PENDING_LOOP=$zxmod_loop
    ZXMOD_PENDING_LOOP_RECORD=$zxmod_loop_record
    printf '%s\n' "$zxmod_loop" > "$zxmod_loop_record" ||
        zxmod_die "cannot record module loop device: $zxmod_id"
    mount -t squashfs -o ro,nodev,nosuid "$zxmod_loop" "$zxmod_mount" ||
        zxmod_die "cannot mount module: $zxmod_source"
    [ "$(zxmod_source_identity "$zxmod_source")" = "$zxmod_identity" ] ||
        zxmod_die 'module source changed while loading'
    zxmod_validate_payload_tree "$zxmod_mount"
    zxmod_validate_paths "$zxmod_mount" "$ZXMOD_RUN_ROOT/active"

    zxmod_candidate="$ZXMOD_RUN_ROOT/active.next.$$"
    zxmod_track_temp "$zxmod_candidate"
    cat "$ZXMOD_RUN_ROOT/active" > "$zxmod_candidate"
    printf '%s\t%s\t%s\n' "$zxmod_id" "$zxmod_source" "$zxmod_identity" >> "$zxmod_candidate"
    zxmod_switch_generation "$zxmod_candidate"
    ZXMOD_PENDING_MOUNT=
    ZXMOD_PENDING_LOOP=
    ZXMOD_PENDING_LOOP_RECORD=
    zxmod_run_hook "$zxmod_mount" post-load
    zxmod_refresh_desktop_sessions
}

unload() {
    [ $# -eq 1 ] || usage
    zxmod_require_root
    zxmod_validate_id "$1"
    zxmod_prepare_runtime
    zxmod_active_has_id "$ZXMOD_RUN_ROOT/active" "$1" ||
        zxmod_die "module is not active: $1"

    zxmod_candidate="$ZXMOD_RUN_ROOT/active.next.$$"
    zxmod_track_temp "$zxmod_candidate"
    awk -F '\t' -v id="$1" '$1 != id { print }' "$ZXMOD_RUN_ROOT/active" > "$zxmod_candidate"
    zxmod_loop_record="$ZXMOD_RUN_ROOT/loops/$1"
    [ -f "$zxmod_loop_record" ] || zxmod_die "module loop record is missing: $1"
    IFS= read -r zxmod_loop < "$zxmod_loop_record"
    case $zxmod_loop in
        /dev/loop[0-9]*) ;;
        *) zxmod_die "module loop record is invalid: $1" ;;
    esac

    zxmod_run_hook "$ZXMOD_RUN_ROOT/modules/$1" pre-unload
    zxmod_switch_generation "$zxmod_candidate"

    umount -l "$ZXMOD_RUN_ROOT/modules/$1" ||
        zxmod_die "module is inactive but its mount could not be detached: $1"
    /usr/bin/losetup --detach "$zxmod_loop" ||
        zxmod_die "module is inactive but its loop device could not be detached: $1"
    rm -f -- "$zxmod_loop_record"
    rmdir "$ZXMOD_RUN_ROOT/modules/$1"
    zxmod_refresh_desktop_sessions
}

case ${1:-} in
    load|unload)
        zxmod_command=$1
        shift
        zxmod_acquire_lock
        "$zxmod_command" "$@"
        ;;
    *) usage ;;
esac
