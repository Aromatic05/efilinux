#!/bin/sh

set -eu

usage() {
    cat >&2 <<'USAGE'
usage: zxmod-build --id ID --version VERSION [--arch ARCH] [--description TEXT]
                   [--packages-file FILE] [--post-load FILE] [--pre-unload FILE]
                   ROOT OUTPUT.zxm

ROOT may contain only usr/ and opt/. Supplemental files are stored under metadata/.
USAGE
    exit 2
}

id=
version=
arch=$(uname -m)
description=
packages_file=
post_load=
pre_unload=
newline='
'

while [ $# -gt 0 ]; do
    case $1 in
        --id) [ $# -ge 2 ] || usage; id=$2; shift 2 ;;
        --version) [ $# -ge 2 ] || usage; version=$2; shift 2 ;;
        --arch) [ $# -ge 2 ] || usage; arch=$2; shift 2 ;;
        --description) [ $# -ge 2 ] || usage; description=$2; shift 2 ;;
        --packages-file) [ $# -ge 2 ] || usage; packages_file=$2; shift 2 ;;
        --post-load) [ $# -ge 2 ] || usage; post_load=$2; shift 2 ;;
        --pre-unload) [ $# -ge 2 ] || usage; pre_unload=$2; shift 2 ;;
        --) shift; break ;;
        -*) usage ;;
        *) break ;;
    esac
done

[ $# -eq 2 ] && [ -n "$id" ] && [ -n "$version" ] || usage
case $id in ''|[!a-z0-9]*|*[!a-z0-9._-]*) usage ;; esac
[ ${#id} -le 64 ] || usage
case $version in ''|*[!A-Za-z0-9._+:-]*) usage ;; esac
case $arch in ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) usage ;; esac
case $description in *"$newline"*) usage ;; esac
for metadata_file in "$packages_file" "$post_load" "$pre_unload"; do
    [ -z "$metadata_file" ] || { [ -f "$metadata_file" ] && [ ! -L "$metadata_file" ]; } || {
        printf 'zxmod-build: metadata input is not a regular file: %s\n' "$metadata_file" >&2
        exit 1
    }
done

root=$1
output=$2
[ -d "$root" ] && [ ! -L "$root" ] || {
    printf 'zxmod-build: ROOT is not a directory\n' >&2
    exit 1
}
[ ! -e "$output" ] || {
    printf 'zxmod-build: refusing to replace %s\n' "$output" >&2
    exit 1
}
case $output in
    *.zxm) ;;
    *) printf 'zxmod-build: output must end in .zxm\n' >&2; exit 1 ;;
esac

for entry in \
    "$root"/* \
    "$root"/.[!.]* \
    "$root"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    case $(basename -- "$entry") in
        usr|opt) [ -d "$entry" ] && [ ! -L "$entry" ] || exit 1 ;;
        *) printf 'zxmod-build: ROOT may only contain usr and opt\n' >&2; exit 1 ;;
    esac
done

zxmod_build_validate_tree() (
    zxmod_build_directory=$1
    for zxmod_build_path in \
        "$zxmod_build_directory"/* \
        "$zxmod_build_directory"/.[!.]* \
        "$zxmod_build_directory"/..?*; do
        [ -e "$zxmod_build_path" ] || [ -L "$zxmod_build_path" ] || continue
        case $zxmod_build_path in
            *"$newline"*)
                printf 'zxmod-build: path contains a newline\n' >&2
                exit 1
                ;;
        esac
        if [ -d "$zxmod_build_path" ] && [ ! -L "$zxmod_build_path" ]; then
            zxmod_build_validate_tree "$zxmod_build_path"
        elif [ -f "$zxmod_build_path" ] || [ -L "$zxmod_build_path" ]; then
            :
        else
            printf 'zxmod-build: special files are not supported\n' >&2
            exit 1
        fi
    done
)

zxmod_build_validate_tree "$root"

work=$(mktemp -d)
trap 'rm -rf "$work"' 0 1 2 15
mkdir -p "$work/metadata" "$work/root"
cp -a "$root/." "$work/root/"
{
    printf 'format=1\n'
    printf 'id=%s\n' "$id"
    printf 'arch=%s\n' "$arch"
    printf 'version=%s\n' "$version"
    [ -n "$description" ] && printf 'description=%s\n' "$description"
} > "$work/metadata/manifest"
if [ -n "$packages_file" ]; then
    cp "$packages_file" "$work/metadata/packages.tsv"
    chmod 0644 "$work/metadata/packages.tsv"
fi
if [ -n "$post_load" ] || [ -n "$pre_unload" ]; then
    mkdir -p "$work/metadata/hooks"
fi
if [ -n "$post_load" ]; then
    cp "$post_load" "$work/metadata/hooks/post-load"
    chmod 0755 "$work/metadata/hooks/post-load"
fi
if [ -n "$pre_unload" ]; then
    cp "$pre_unload" "$work/metadata/hooks/pre-unload"
    chmod 0755 "$work/metadata/hooks/pre-unload"
fi
mksquashfs "$work" "$output" -noappend -comp zstd -Xcompression-level 19 \
    -all-root -no-xattrs -no-exports -mkfs-time 0 -all-time 0 >/dev/null
