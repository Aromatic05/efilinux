#!/usr/bin/sh

set -u

case ${1:-} in
    start)
        test -f /etc/zxmod.conf || exit 0
        mkdir -p /run/zxmod
        rm -f /run/zxmod/startup.failed
        if output=$(/usr/bin/zxmod startup 2>&1); then
            test -z "$output" || printf '%s\n' "$output"
            exit 0
        fi
        status=$?
        {
            printf 'zxmod startup failed with status %s\n' "$status"
            test -z "$output" || printf '%s\n' "$output"
        } > /run/zxmod/startup.failed
        cat /run/zxmod/startup.failed >&2
        command -v logger >/dev/null 2>&1 && \
            logger -t zxmod -f /run/zxmod/startup.failed || true
        exit 0
        ;;
    stop)
        exit 0
        ;;
    *)
        printf 'usage: %s {start|stop}\n' "$0" >&2
        exit 2
        ;;
esac
