#!/bin/sh
set -eu

backup_owner=user
backup_home=/home/user
if ! /usr/bin/id "$backup_owner" >/dev/null 2>&1; then
    backup_owner=root
    backup_home=/root
fi
backup_group=$(/usr/bin/id -gn "$backup_owner")
backup_dir="$backup_home/EFI-Boot-Backups"
timestamp=$(/usr/bin/date -u +%Y%m%dT%H%M%SZ)
backup_file="$backup_dir/efibootmgr-$timestamp.txt"
backup_temp="$backup_file.tmp.$$"

if [ -d /sys/firmware/efi/efivars ]; then
    if /usr/bin/install -d -m0750 -o "$backup_owner" -g "$backup_group" "$backup_dir"; then
        if {
            printf 'Captured: %s UTC\n\n' "$timestamp"
            /usr/bin/efibootmgr -v
        } > "$backup_temp"; then
            /usr/bin/chown "$backup_owner:$backup_group" "$backup_temp"
            /usr/bin/chmod 0640 "$backup_temp"
            /usr/bin/mv "$backup_temp" "$backup_file"
        else
            /usr/bin/rm -f -- "$backup_temp"
            echo 'Warning: unable to capture the current EFI boot entries.' >&2
        fi
    else
        echo 'Warning: unable to create the EFI boot backup directory.' >&2
    fi
fi

exec /opt/recovery/bin/efibooteditor
